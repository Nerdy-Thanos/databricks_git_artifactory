# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log


# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Saved plans and JSON exports can contain credentials.
*.tfplan
*.tfplan.*
tfplan
tfplan.*
plan.out
plan.json

# Local environment credentials; keep sanitized examples trackable.
.env
.env.*
!.env.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

.superpowers/
docs/

*.tfvars
*.tfvars.json
